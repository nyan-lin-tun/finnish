---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import LessonList from '../../components/LessonList.astro';
const lessons = (await getCollection('lessons', ({ data }) => !data.draft)).sort((a,b) => b.data.day-a.data.day);
---
<Layout title="All study days"><p class="eyebrow">THE NOTEBOOK</p><h1>All study days</h1><LessonList lessons={lessons} /></Layout>
