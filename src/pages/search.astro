---
import Layout from '../layouts/Layout.astro';
import { topics } from '../content.config';
---
<Layout title="Search">
  <h1>Search your notes</h1>
  <label for="topic">Topic</label>
  <select id="topic"><option value="">All topics</option>{topics.map(topic => <option value={topic}>{topic}</option>)}</select>
  <p id="status" role="status">Enter a word or phrase in the search bar.</p>
  <ul id="results" class="lessons"></ul>
  <button id="more" hidden>Load more</button>
  <noscript>Search needs JavaScript. You can still browse all days and topics.</noscript>
</Layout>
<script>
  const input = document.querySelector<HTMLInputElement>('#query')!;
  const form = input.form!;
  const topic = document.querySelector<HTMLSelectElement>('#topic')!;
  const status = document.querySelector<HTMLParagraphElement>('#status')!;
  const results = document.querySelector<HTMLUListElement>('#results')!;
  const more = document.querySelector<HTMLButtonElement>('#more')!;
  type Result = { data: () => Promise<{url:string; meta: {title?:string}; excerpt:string}> };
  type Index = { options: (options: {baseUrl:string}) => Promise<void>; search: (query:string, options:object) => Promise<{results:Result[]}> };
  let index: Promise<Index> | undefined;
  let generation = 0;
  let matches: Result[] = [];
  let shown = 0;
  async function renderBatch(current: number) {
    const batch = await Promise.all(matches.slice(shown, shown + 10).map(result => result.data()));
    if (current !== generation) return;
    for (const data of batch) {
      const li = document.createElement('li');
      const link = document.createElement('a');
      link.href = data.url;
      link.textContent = data.meta.title || 'Study note';
      const excerpt = document.createElement('p');
      // Treat index text as text; discard Pagefind's highlighting markup.
      excerpt.textContent = new DOMParser().parseFromString(data.excerpt, 'text/html').body.textContent;
      li.append(link, excerpt);
      results.append(li);
    }
    shown += batch.length;
    more.hidden = shown >= matches.length;
  }
  async function search() {
    const current = ++generation;
    const query = input.value.trim();
    results.replaceChildren(); more.hidden = true; shown = 0;
    const params = new URLSearchParams({ q: query });
    if (topic.value) params.set('topic', topic.value);
    history.replaceState(null, '', `${location.pathname}?${params}`);
    if (!query) { status.textContent = 'Enter a word or phrase in the search bar.'; return; }
    status.textContent = 'Searching…';
    try {
      index ??= import(/* @vite-ignore */ `${import.meta.env.BASE_URL}pagefind/pagefind.js`).then(async (module: Index) => {
        await module.options({baseUrl: import.meta.env.BASE_URL}); return module;
      });
      const engine = await index;
      const response = await engine.search(query, { filters: topic.value ? { Topic: topic.value } : {} });
      if (current !== generation) return;
      matches = response.results;
      status.textContent = matches.length ? `${matches.length} matching lessons` : 'No matches. Try a shorter word or another topic.';
      await renderBatch(current);
    } catch {
      if (current !== generation) return;
      index = undefined;
      status.textContent = import.meta.env.DEV
        ? 'Search is unavailable in the development server. Stop it and run npm start to build and preview the searchable site.'
        : 'Search could not load. Please try again, or browse All days.';
    }
  }
  form.addEventListener('submit', event => { event.preventDefault(); void search(); });
  topic.addEventListener('change', () => { void search(); });
  more.addEventListener('click', async () => {
    more.disabled = true;
    try { await renderBatch(generation); }
    catch { status.textContent = 'Could not load more results. Please try again.'; }
    finally { more.disabled = false; }
  });
  const params = new URLSearchParams(location.search);
  input.value = params.get('q') || '';
  topic.value = params.get('topic') || '';
  void search();
</script>
