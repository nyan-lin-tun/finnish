---
import { getCollection } from 'astro:content';
import { topics } from '../content.config';
import Layout from '../layouts/Layout.astro';
import LessonList from '../components/LessonList.astro';
const lessons = (await getCollection('lessons', ({ data }) => !data.draft)).sort((a,b) => b.data.day-a.data.day);
---
<Layout title="My study notebook">
  <p class="eyebrow">SUOMI · PERSONAL STUDY NOTEBOOK</p>
  <h1>A little Finnish,<br />every day.</h1>
  <p class="intro">Find a word, revisit a rule, or learn from a mistake.</p>
  <section aria-labelledby="browse"><h2 id="browse">Browse by topic</h2>
    <div class="topics">{topics.map(topic => <a href={`${import.meta.env.BASE_URL}topics/${topic}/`}>{topic}<span>{lessons.filter(lesson => lesson.data.topics.includes(topic)).length} lessons →</span></a>)}</div>
  </section>
  <section aria-labelledby="recent"><h2 id="recent">Recent study days</h2><LessonList lessons={lessons.slice(0, 10)} /></section>
</Layout>
