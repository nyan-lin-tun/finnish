{
  "name": "nyan-finnish-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build && pagefind --site dist",
    "preview": "astro preview",
    "test": "node scripts/verify.mjs",
    "start": "npm run build && npm run preview",
    "lint": "eslint . --max-warnings=0",
    "lint:staged": "lint-staged",
    "prepare": "husky"
  },
  "dependencies": {
    "astro": "^7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "pagefind": "^1.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,astro}": "eslint --max-warnings=0"
  }
}
